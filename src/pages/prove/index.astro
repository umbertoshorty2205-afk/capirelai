---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const articoli = await getCollection("prove");
articoli.sort((a, b) => b.data.data.getTime() - a.data.data.getTime());
---

<MainLayout title="Prove — Capire l'AI" description="Test, esperimenti e valutazioni sul campo dei modelli e degli strumenti di IA." current="prove">
  <h1>Prove</h1>
  <p>Esperimenti, benchmark informali e casi d'uso reali analizzati senza hype.</p>

  {
    articoli.length > 0 ? (
      <div class="card-grid">
        {articoli.map((a) => (
          <a class="card" href={`/prove/${a.slug}`} style="text-decoration:none; color:inherit;">
            <h3>{a.data.titolo}</h3>
            <p style="margin:0 0 0.4rem; color:var(--muted);">{a.data.descrizione}</p>
            <span class="meta">
              {a.data.autore} · {a.data.data.toLocaleDateString("it-IT")}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty">Nessun articolo ancora. Torna presto con nuovi contenuti.</p>
    )
  }
</MainLayout>