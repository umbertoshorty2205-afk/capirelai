---
// Importa il componente principale interattivo
import CapirelAiHero from '../components/webgl/CapirelAiHero';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Capire l'AI — Divulgazione, Ricerca &amp; Forum Tecnico</title>
    <meta
      name="description"
      content="Analisi tecnica di LLM, Transformer, RAG e modelli open-weights con prove empiriche e forum di confronto aperto."
    />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      /* Reset globale per evitare bordi bianchi o scroll orizzontali */
      html,
      body {
        margin: 0;
        padding: 0;
        background-color: #000000;
        color: #ffffff;
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        overflow-x: hidden;
      }
      * {
        box-sizing: border-box;
      }
    </style>
  </head>
  <body>
    <!-- client:load è il comando che attiva JavaScript per il Forum e gli Articoli -->
    <CapirelAiHero client:load />
  </body>
</html>