    {
      "parameters": {
        "jsCode": "const cfg = $('0. Inserisci Chiavi API').first().json;\nconst clips = ($input.first().json.clips || []).map(c => c.video?.url).filter(Boolean);\nconst tts = $('7b. Scarica Audio URL').first().json;\nconst plan = $('6. Parse Storyboard JSON').first().json;\nconst scenes = plan.scenes || [];\n\nconst modifications = {\n  'Voiceover.source': tts.audio?.url || '',\n  'CTA-Text.text': 'capirelai.com — Kit 10 Prompt R.O.F. Gratis'\n};\n\nscenes.forEach((sc, idx) => {\n  const n = idx + 1;\n  if (clips[idx]) modifications[`Clip-${n}.source`] = clips[idx];\n  modifications[`Title-${n}.text`] = sc.on_screen_title || '';\n  modifications[`Sub-${n}.text`] = sc.on_screen_sub || '';\n});\n\nreturn [{\n  json: {\n    template_id: cfg.creatomate_template_id,\n    modifications,\n    caption_ig: plan.caption_ig || ''\n  }\n}];"
      },
