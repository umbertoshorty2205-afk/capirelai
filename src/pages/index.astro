---
import CapirelAiHero from "../components/webgl/CapirelAiHero";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CAPIRELAI — Forum & AI Research Hub</title>
    <meta
      name="description"
      content="Divulgazione sull'intelligenza artificiale in italiano: concetti, guide, prove sul campo e aggiornamenti. Est. 2026."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        overflow-x: hidden;
        overflow-y: auto;
        scroll-behavior: smooth;
        background-color: #000000;
        color: #dddddd;
        font-family: "SF Mono", "Menlo", "Consolas", "Liberation Mono", monospace;
        font-size: 13px;
        line-height: 1.35;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        -webkit-font-smoothing: antialiased;
      }

      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </head>
  <body>
    <CapirelAiHero client:only="react" />
  </body>
</html>