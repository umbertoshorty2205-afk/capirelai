      "id": "github-list-jarvis",
      "name": "1. Leggi Inbox Jarvis (GitHub)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    },
    {
      "parameters": {
        "jsCode": "// Seleziona il file .md più recente in content/jarvis\nconst files = $input.all().map(i => i.json).filter(f => f.type === 'file' && f.name && f.name.endsWith('.md'));\nfiles.sort((a, b) => b.name.localeCompare(a.name));\nif (!files.length) throw new Error('Nessun file .md trovato in content/jarvis');\nconst target = files[0];\nreturn [{ json: { path: target.path, name: target.name, url: target.url } }];"
      },
      "id": "pick-latest-brief",
      "name": "2. Prendi Ultimo Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 300]
    },
    {
      "parameters": {
        "url": "={{$json.url}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$('0. Inserisci Chiavi API').first().json.github_token}}"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "github-read-brief",
      "name": "3. Scarica Testo Markdown",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data || '';\nconst fmMatch = raw.match(/^---\\s*\\n([\\s\\S]*?)\\n---\\s*\\n([\\s\\S]*)$/);\nconst frontmatter = {};\nlet body = raw;\nif (fmMatch) {\n  body = fmMatch[2];\n  for (const line of fmMatch[1].split('\\n')) {\n    const m = line.match(/^([A-Za-z0-9_]+):\\s*(.*)$/);\n    if (m) frontmatter[m[1]] = m[2].trim().replace(/^[\"']|[\"']$/g, '');\n  }\n}\nconst audioLines = [...body.matchAll(/Audio:\\s*\"([\\s\\S]*?)\"/g)].map(m => m[1].trim());\nconst spokenText = audioLines.length ? audioLines.join(' ') : body.replace(/[#>*_`]/g, '').slice(0, 1200);\nreturn [{ json: { title: frontmatter.title || 'Capire AI Reel', slug: frontmatter.slug || 'reel-jarvis', hook: frontmatter.hook || '', cta: frontmatter.cta || '', spokenText } }];"
      },
      "id": "parse-jarvis-md",
      "name": "4. Estrai Script & Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{$('0. Inserisci Chiavi API').first().json.gemini_api_key}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Sei un 3D Motion Director stile @leomarighetti.mov. Trasforma questo script parlato di Capire l'AI in un JSON rigoroso con 5 scene da 5 secondi ciascuna sincronizzate allo script.\\n\\nREGOLA VISIVA OBBLIGATORIA (Style Lock su tutte le scene):\\n- Fotografia macro cinematografica reale su scrivania in legno di noce caldo, tastiera meccanica nero opaco con keycap minimal, monitor ultra-pulito sfocato sullo sfondo, lente 85mm macro f/1.8 con bokeh cremoso e profondità di campo stretta, luce calda laterale da lampada da studio + lieve rim-light azzurro freddo, grana pellicola 35mm naturale, ombre di contatto morbide.\\n- VIETATO: colori neon acidi, cyber-griglie, robot cartoon, testo dentro i prompt immagine/video.\\n- Composizione verticale 9:16 con spazio negativo pulito in alto e in basso per le safe-zone Instagram.\\n\\nScript da adattare:\\nTITOLO: \" + JSON.stringify($json.title) + \"\\nTESTO PARLATO: \" + JSON.stringify($json.spokenText) + \"\\n\\nRispondi SOLO con JSON valido nel formato: { \\\"voiceover_clean\\\": \\\"testo italiano fluido senza parentesi o simboli\\\", \\\"caption_ig\\\": \\\"caption pronta\\\", \\\"scenes\\\": [ { \\\"index\\\": 1, \\\"duration\\\": 5, \\\"on_screen_title\\\": \\\"MAX 4 PAROLE MAIUSCOLE\\\", \\\"on_screen_sub\\\": \\\"breve etichetta\\\", \\\"keyframe_prompt\\\": \\\"prompt dettagliato in inglese con lo Style Lock\\\", \\\"motion_prompt\\\": \\\"movimento camera lento continuo in inglese per Kling image-to-video\\\" } ] }\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.4\n  }\n}",
        "options": {}
      },
      "id": "gemini-director",
      "name": "5. Regista AI (Storyboard + Style Lock)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 300]
    },
    {
      "parameters": {
        "jsCode": "const rawText = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nconst plan = JSON.parse(rawText);\nreturn [{ json: plan }];"
      },
